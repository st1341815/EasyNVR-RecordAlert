#!/bin/bash
# 安装前检查：本应用只用 Python 标准库，但必须有 python3。
#
# 只做存在性检查，不在这里建目录、不写 python_path：
#   安装阶段 $TRIM_PKGVAR（如 /vol1/@appdata/erm）可能还没建好，且 /vol1/@appdata
#   只有 root 能写；提前 mkdir + 写文件会报 "No such file or directory"，
#   最终被平台记成 APP_INSTALL_FAILED_INSTALL_INIT_EXCEPTION。
#   python_path 由 install_callback 在目录就绪后再写（main 读不到时也有
#   command -v python3 兜底，所以这里写不写都不影响启动）。

PYB="$(command -v python3 2>/dev/null || command -v python 2>/dev/null)"
if [ -n "${PYB}" ]; then
    exit 0
fi

MSG="未找到 python3，EasyNVR 录像监控 无法运行。请确认 fnOS 运行环境已安装 Python3。"
if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    printf '%s\n' "${MSG}" > "${TRIM_TEMP_LOGFILE}"
fi
echo "${MSG}" >&2
exit 1
