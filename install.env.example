# install.env 示例：安装时预填向导值
#
# 用法：
#   图形界面：应用中心 → 手动安装 → 上传 erm-<版本>.fpk → 按向导填写
#   命令行：  appcenter-cli install-fpk ./dist/erm.fpk -e ./install.env
#             （trim-cli 远程安装：app install-fpk <本地fpk> -e install.env --volume-id <n> --yes）
#
# 说明（v1.0.8 起）：
#   · 安装向导不再询问录像目录与通道，只问推送渠道与检测参数；
#   · wizard_record_root 仍可用（命令行预置目录），装完在应用页面里也能改；
#   · 通道不需要配置：按 EasyNVR 真实布局 <摄像头ID>/profile_N/<YYYYMMDD>/ 自动发现；
#   · 装完必须到「应用中心 → 本应用 → 设置 → 授权目录」把录像目录加为可读，然后重启应用。

# EasyNVR 录像根目录（<摄像头ID>/profile_N/<YYYYMMDD>/ 的上一层）—— 可选
wizard_record_root=/vol3/1000/NVR/easynvr_rec

# 推送渠道（启用/停用）
wizard_push_dingtalk=启用
wizard_dingtalk_webhook=
wizard_dingtalk_secret=
wizard_push_wechat=停用
wizard_wechat_webhook=
wizard_push_feishu=停用
wizard_feishu_webhook=

# 检测参数
wizard_scan_interval=60
wizard_alert_threshold_minutes=60
wizard_alert_silence_minutes=120
wizard_daily_report_time=08:00
wizard_timezone=Asia/Shanghai
